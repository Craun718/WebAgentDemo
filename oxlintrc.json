{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["typescript", "unicorn", "import", "vue"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {},
  "overrides": [
    {
      "files": ["apps/frontend/**"],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["apps/backend/**"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", ".moon/cache/", "coverage/"]
}
