{
    "name": "@web-agent/backend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsup src/index.ts --format esm --dts --out-dir dist",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@hono/node-server": "^2.0.10",
        "@web-agent/shared": "workspace:*",
        "hono": "^4.12.31",
        "openai": "^6.48.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1"
    }
}
